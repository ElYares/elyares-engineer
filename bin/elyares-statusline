#!/usr/bin/env bash
# Envoltura de la barra de estado de Claude Code.
#
# Corre la barra que ya tenías (install.sh guarda su comando en
# ~/.config/elyares-engineer/statusline.cmd) y, de paso, le cuenta a elyares-engineer
# cuánto contexto lleva la sesión y cuánto del límite de 5 h. Los hooks de
# Claude Code no traen ese dato; la barra de estado es el único sitio donde
# Claude lo entrega.
#
# Esto corre en cada pintada de la barra, así que solo avisa cuando cambia un
# porcentaje entero.

input="$(cat)"

orig="${XDG_CONFIG_HOME:-$HOME/.config}/elyares-engineer/statusline.cmd"
[ -s "$orig" ] && printf '%s' "$input" | sh -c "$(cat "$orig")"

IFS=$'\t' read -r sid ctx lim < <(jq -r '[.session_id // "",
    (.context_window.used_percentage // 0 | floor),
    (.rate_limits.five_hour.used_percentage // 0 | floor)] | @tsv' <<<"$input" 2>/dev/null)
[ -n "$sid" ] || exit 0

cache="${XDG_RUNTIME_DIR:-/tmp}/elyares-status-$sid"
[ "$(cat "$cache" 2>/dev/null)" = "$ctx $lim" ] && exit 0
printf '%s' "$ctx $lim" > "$cache"

hook="$(dirname "$(readlink -f "$0")")/elyares-hook"
# Sin stdout heredado: Claude espera a que se cierre para pintar la barra.
(jq -c '{session_id, cwd: (.workspace.current_dir // .cwd),
         context_pct: (.context_window.used_percentage // 0),
         limit_pct: (.rate_limits.five_hour.used_percentage // 0)}' <<<"$input" 2>/dev/null |
  "$hook" status &) >/dev/null 2>&1
exit 0
