#!/usr/bin/python3
"""Manda un evento de Claude Code a la mascota.

Uso (desde settings.json):  elyares-hook <evento>   con el payload del hook por stdin
Eventos: start tool tool-done permission idle stop failure session-end ask
         compact (hook PreCompact), status (barra de estado: uso de contexto y
         del límite de 5 h) y cmd-done (un comando largo de la terminal terminó)

Nunca falla: si la mascota no está corriendo, sale en silencio.

Todos los eventos son de una sola vía menos `ask` (hook PermissionRequest), que
espera a que se pulse Permitir o Denegar en la isla y lo imprime en stdout. En
modo interactivo Claude Code corre este hook a la par del prompt de la
terminal: gana el primero que conteste, así que esperar no bloquea nada. En
modo headless (`claude -p`, SDK) sí bloquea, y ahí sale sin decidir.
"""
import json
import os
import socket
import sys
import time

KEEP = ('tool_name', 'tool_input', 'message', 'notification_type', 'reason',
        'error_type', 'agent_id', 'context_pct', 'limit_pct', 'command', 'exit_code', 'seconds')
KEEP_INPUT = ('file_path', 'notebook_path', 'command', 'pattern', 'path', 'url',
              'query', 'description', 'subagent_type')
# El fragmento que se edita, para la vista previa de la isla. Va más largo que
# lo demás, pero con tope: un Write puede traer megas de contenido.
EDIT_INPUT = ('old_string', 'new_string', 'content', 'new_source')
EDIT_CHARS, MAX_EDITS = 6000, 3


def trim(ti):
    """Lo que se manda de tool_input: solo lo que la isla muestra, y recortado."""
    out = {}
    for k, v in ti.items():
        if k in KEEP_INPUT:
            out[k] = v[:300] if isinstance(v, str) else v
        elif k in EDIT_INPUT and isinstance(v, str):
            out[k] = v[:EDIT_CHARS]
        elif k == 'edits' and isinstance(v, list):
            out[k] = [{kk: vv[:EDIT_CHARS] for kk, vv in e.items()
                       if kk in EDIT_INPUT and isinstance(vv, str)}
                      for e in v[:MAX_EDITS] if isinstance(e, dict)]
    return out

# Piden respuesta del usuario, no permiso: un "allow" sin respuesta no sirve.
NO_ASK = ('AskUserQuestion', 'ExitPlanMode')


def interactive():
    """¿El proceso de Claude que nos lanzó tiene una terminal?"""
    pid = os.getppid()
    for _ in range(4):
        try:
            with open(f'/proc/{pid}/comm') as f:
                comm = f.read().strip()
            if comm == 'claude':
                return os.readlink(f'/proc/{pid}/fd/0').startswith(('/dev/pts/', '/dev/tty'))
            with open(f'/proc/{pid}/stat') as f:
                pid = int(f.read().rsplit(')', 1)[1].split()[1])
        except (OSError, ValueError, IndexError):
            return False
    return False


def main():
    event = sys.argv[1] if len(sys.argv) > 1 else ''
    path = os.path.join(os.environ.get('XDG_RUNTIME_DIR', f'/run/user/{os.getuid()}'),
                        'elyares.sock')
    if not event or not os.path.exists(path):
        return
    try:
        payload = json.load(sys.stdin)
    except ValueError:
        payload = {}
    ask = event == 'ask'
    if ask and (payload.get('tool_name') in NO_ASK or not interactive()):
        return
    msg = {
        'event': event,
        'ts': time.time(),
        'session_id': payload.get('session_id') or 'unknown',
        'cwd': payload.get('cwd') or os.getcwd(),
        'tmux': os.environ.get('TMUX', ''),
        'pane': os.environ.get('TMUX_PANE', ''),
    }
    msg.update({k: payload[k] for k in KEEP if k in payload})
    ti = msg.get('tool_input')
    if isinstance(ti, dict):
        msg['tool_input'] = trim(ti)
    if ask:
        msg['reply'] = True
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
        s.settimeout(0.3)
        s.connect(path)
        s.sendall((json.dumps(msg) + '\n').encode())
        if not ask:
            return
        # Sin límite propio: el timeout del hook en settings.json manda.
        s.settimeout(None)
        data = b''
        while not data.endswith(b'\n'):
            b = s.recv(4096)
            if not b:
                return
            data += b
    decision = json.loads(data)
    if decision.get('behavior') in ('allow', 'deny'):
        # Solo stdout decide; lo demás lo interpretaría Claude como respuesta.
        print(json.dumps({'hookSpecificOutput': {'hookEventName': 'PermissionRequest',
                                                 'decision': decision}}))


try:
    main()
except Exception:
    pass
sys.exit(0)
