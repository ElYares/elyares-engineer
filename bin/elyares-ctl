#!/usr/bin/python3
"""Manda una orden a elyares-engineer. Pensado para atajos de Hyprland.

Uso: elyares-ctl <orden>

    open      abre la isla con lo que hace la sesión; otra vez, la cierra
    chat [quién] [--dir carpeta]
              abre el chat con Claude, listo para escribir, en el proyecto de la
              sesión de tmux en la que estás; otra vez, lo cierra.
              Con quién: engineer, architect, auditor, reviewer, designer, mobile,
              devops o researcher, el chat de ese agente.
              Con --dir: en el proyecto de esa carpeta
    window [toggle]
              abre la app en una ventana normal, con el tablero y el chat, y
              esconde la isla mientras está abierta; cerrarla devuelve la isla.
              Con la ventana ya abierta, la enfoca; con `toggle`, la cierra.
              Si elyares-engineer no corre, lo arranca
    projects  abre el panel de proyectos, para empezar a trabajar en uno; otra vez, lo cierra
    workflows abre el panel de workflows: cadenas de agentes que se guardan y se
              lanzan sobre un proyecto; otra vez, lo cierra
    move <dónde>
              corre la isla a lo ancho de la pantalla: left y right, al siguiente
              sitio de ese lado; up y down, la suben y la bajan; center, la centra;
              reset, a arriba al centro, su sitio de siempre; o un número del
              0 (izquierda) al 100 (derecha). También se arrastra con Alt
    hide      esconde la isla del todo; otra vez, la vuelve a mostrar
    compact   prende o apaga el modo compacto
    pin       fija la isla abierta con todo a la vista; otra vez, la suelta
    tab       pasa a la pestaña (la sesión) que sigue en el tablero
    steps     abre el desglose de uno de los cuatro; otra vez, el del que sigue
    theme     vuelve a leer el color de acento del tema de omarchy
    reload    vuelve a arrancar la isla con el código de su carpeta, sin perder
              las sesiones ni los chats; con un turno en curso, al acabar
    glass     prende o apaga el modo vidrio
    allow     permite lo que pide el permiso que la isla tiene a la vista
    deny      lo deniega, y corta el turno como el No de la terminal
    status    lista las fuentes de elyares-engineer y cómo está cada una
    toggle <fuente>
              prende o apaga una fuente: devherd, coffe, github, terminal, usage
"""
import json
import os
import socket
import subprocess
import sys
import time

ORDERS = ('open', 'chat', 'window', 'projects', 'workflows', 'move', 'hide', 'compact', 'pin', 'tab', 'steps', 'theme', 'reload',
          'glass', 'allow', 'deny', 'status', 'toggle')
REPLIES = ('allow', 'deny', 'status', 'reload')    # las que esperan a que elyares-engineer conteste
SOURCES = ('devherd', 'coffe', 'github', 'terminal', 'usage')
AGENTS = ('engineer', 'architect', 'auditor', 'reviewer', 'designer', 'mobile', 'devops', 'researcher')
PLACES = ('left', 'right', 'center', 'up', 'down', 'reset')
STATES = {'on': 'conectada', 'off': 'apagada', 'bad': 'con problemas', 'unknown': 'sin datos'}


def wake(path):
    """Abrir la app desde el lanzador no tiene que fallar porque el servicio
    esté parado: lo arranca y espera a que abra su socket (hasta 10 s)."""
    def up():
        try:
            with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
                s.settimeout(0.3)
                s.connect(path)
            return True
        except OSError:
            return False
    if up():
        return
    try:
        subprocess.run(['systemctl', '--user', 'start', 'elyares-engineer'], timeout=10, check=False,
                       capture_output=True)
    except (OSError, subprocess.SubprocessError):
        return
    for _ in range(50):
        if up():
            return
        time.sleep(0.2)


def main():
    args = sys.argv[1:]
    folder = None
    if '--dir' in args:
        at = args.index('--dir')
        folder = os.path.abspath(args[at + 1]) if at + 1 < len(args) else ''
        del args[at:at + 2]
    order = args[0] if args else ''
    source = args[1] if len(args) > 1 else ''
    if folder is not None and (order != 'chat' or not os.path.isdir(folder)):
        print(__doc__.strip(), file=sys.stderr)
        return 2
    if order == 'move' and source not in PLACES and not (source.isdigit() and int(source) <= 100):
        print(__doc__.strip(), file=sys.stderr)
        return 2
    if order not in ORDERS or (order == 'toggle' and source not in SOURCES) or (
            order == 'chat' and source and source not in AGENTS) or (
            order == 'window' and source not in ('', 'toggle')):
        print(__doc__.strip(), file=sys.stderr)
        return 2
    msg = {'control': order}
    if order == 'toggle':
        msg['source'] = source
    if order == 'chat' and source:
        msg['agent'] = source
    if order == 'move':
        msg['where'] = source
    if order == 'window' and source:
        msg['how'] = source
    if folder:
        msg['cwd'] = folder
    if order in REPLIES:
        msg['reply'] = True
    path = os.path.join(os.environ.get('XDG_RUNTIME_DIR', f'/run/user/{os.getuid()}'),
                        'elyares.sock')
    if order == 'window':
        wake(path)
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.settimeout(0.3)
            s.connect(path)
            s.sendall((json.dumps(msg) + '\n').encode())
            if order not in REPLIES:
                return 0
            s.settimeout(25 if order == 'reload' else 2)    # antes de recargar comprueba que el código arranca
            data = b''
            while not data.endswith(b'\n'):
                b = s.recv(4096)
                if not b:
                    break
                data += b
    except OSError:
        print('elyares-ctl: elyares-engineer no está corriendo', file=sys.stderr)
        return 1
    answer = json.loads(data or b'{}')
    if order != 'status':
        if not answer.get('ok'):
            print(f"elyares-ctl: {answer.get('why') or 'elyares-engineer no contestó'}", file=sys.stderr)
        elif answer.get('note'):
            print(answer['note'])
        return 0 if answer.get('ok') else 1
    for src in answer.get('sources', []):
        print(f"{src['label']:<10}{STATES.get(src['state'], src['state']):<15}{src['note']}".rstrip())
    return 0


sys.exit(main())
